# Hermes Agent API Keys
# 複製此檔為 .env 並填入你的 token
# 至少需要設定一種 LLM provider

# === 方式 1: GitHub Copilot (免費，需要 gh cli 已登入) ===
# 執行 gh auth token 取得，或留空讓 hermes 自動偵測
GITHUB_TOKEN=

# === 方式 2: OpenRouter (200+ models) ===
# 取得: https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# === 方式 3: Anthropic 直連 ===
# 取得: https://console.anthropic.com/
# ANTHROPIC_API_KEY=

# === 方式 4: OpenAI ===
# OPENAI_API_KEY=
