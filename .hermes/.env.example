# Hermes Agent API Keys
# 複製此檔為 .env 並填入你的 token
# 至少需要設定一種 LLM provider

# === 方式 1: GitHub Copilot（需要 gh CLI 以 OAuth 登入） ===
# 僅支援 gho_ 開頭的 OAuth token，不支援 github_pat_ 個人存取權杖
GITHUB_TOKEN=

# === 方式 2: OpenRouter (200+ models) ===
# 取得: https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# === 方式 3: Anthropic 直連 ===
# 取得: https://console.anthropic.com/
# ANTHROPIC_API_KEY=

# === 方式 4: OpenAI ===
# OPENAI_API_KEY=
