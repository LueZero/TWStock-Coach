        "report": "TaiwanStockFinancialStatements",
        "fields": ["Revenue"],
        "note": "",
        "requires": null,
        "kind": "metrics"
      },
      {
        "id": "gross-profit-growth-rate",
        "label": "毛利成長率",
        "keys": ["gross_yoy", "gross_ttm_yoy"],
        "report": "TaiwanStockFinancialStatements",
        "fields": ["GrossProfit"],
        "note": "",
        "requires": null,
        "kind": "metrics"
      },
      {
        "id": "operating-income-growth-rate",
        "label": "營業利益成長率",
        "keys": ["operating_yoy", "operating_ttm_yoy"],
        "report": "TaiwanStockFinancialStatements",
        "fields": ["OperatingIncome"],
        "note": "",
        "requires": null,
        "kind": "metrics"
      },
      {
        "id": "net-income-growth-rate",
        "label": "稅後淨利成長率",
        "keys": ["net_yoy", "net_ttm_yoy"],
        "report": "TaiwanStockFinancialStatements",
        "fields": ["IncomeAfterTaxes"],
        "note": "",
        "requires": null,
        "kind": "metrics"
      },
      {
        "id": "eps-growth-rate",
        "label": "每股盈餘成長率",
        "keys": ["eps"],
        "report": "TaiwanStockFinancialStatements",
        "fields": ["EPS"],
        "note": "",
        "requires": "需要同一股數基準的追溯調整 EPS 及配股／分割紀錄。先顯示來源 EPS，不用未調整 EPS 直接計算年增率。",
        "kind": "metrics"
      },
      {
        "id": "current-contract-liabilities-growth-rate",
        "label": "合約負債成長率",
        "keys": ["contract_yoy", "contract_qoq"],
        "report": "TaiwanStockBalanceSheet",
        "fields": ["CurrentContractLiabilities"],
        "note": "同季年增、前季季增分開；基期為零或負值不計百分比。",
        "requires": null,
        "kind": "metrics"
      }
    ]
  },
  {
    "id": "valuation",
    "label": "價值評估",
    "pages": [
