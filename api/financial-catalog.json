      },
      {
        "id": "pb-band",
        "label": "股價淨值比河流圖",
        "keys": ["pbr"],
        "report": null,
        "fields": null,
        "note": "",
        "requires": "需要各期可驗證每股淨值、原始股價及公司行動；不拿當期淨值套用所有過往價格。",
        "kind": "metrics"
      },
      {
        "id": "dividend-yield",
        "label": "現金股利殖利率",
        "keys": ["dividend_yield"],
        "report": null,
        "fields": null,
        "note": "",
        "requires": null,
        "kind": "metrics"
      },
      {
        "id": "average-dividend-yield",
        "label": "平均現金股息殖利率",
        "keys": [],
        "report": null,
        "fields": null,
        "note": "",
        "requires": "需要完整年度現金股利、指定平均年數、股數調整與對應原始股價。日殖利率平均不等於平均股息殖利率。",
        "kind": "dividends"
      },
      {
        "id": "average-dividend-yield-band",
        "label": "平均現金股息河流圖",
        "keys": [],
        "report": null,
        "fields": null,
        "note": "",
        "requires": "需要逐時點可得的完整年度現金股利、平均窗口、股數調整及原始價格。固定殖利率價格帶不當成保證合理價。",
        "kind": "dividends"
      }
    ]
  }
]
